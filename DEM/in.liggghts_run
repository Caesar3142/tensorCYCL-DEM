# Coupled cyclone DEM: periodically inject dust/fine sand through inlet.stl.
echo            both
log             ../DEM/log.liggghts

atom_style      granular
atom_modify     map array
atom_modify     sort 0 0.0
communicate     single vel yes

boundary        f f f
newton          off

units           si
processors      2 2 2

region          domain block -0.18 0.18 -0.18 0.18 -0.62 0.19 units box
create_box      1 domain

neighbor        0.0006 bin
neigh_modify    delay 0

# Softened contacts. Low friction + no tangential history so grains cannot
# lock into a static centrifugal ring on the shallow cone wall.
fix         m1 all property/global youngsModulus peratomtype 5.e7
fix         m2 all property/global poissonsRatio peratomtype 0.25
fix         m3 all property/global coefficientRestitution peratomtypepair 1 0.20
fix         m4 all property/global coefficientFriction peratomtypepair 1 0.02

pair_style  gran model hertz tangential no_history
pair_coeff  * *

# DEM dt = 5e-7 s (half of prior 1e-6) for the stiffer Young modulus / finer grains.
timestep    0.0000005
fix         gravi all gravity 9.81 vector 0.0 0.0 -1.0

# Cyclone wall. inlet.stl and outlet.stl are boundary caps, not particle walls.
# DEM/body.stl is synced+cleaned from CFD by buildMesh.sh (ASCII, LIGGGHTS-safe).
fix         bodyMesh all mesh/surface file ../DEM/body.stl type 1 curvature_tolerant yes
fix         walls all wall/gran model hertz tangential no_history mesh n_meshes 1 meshes bodyMesh

# Dust + fine sand: d = 0.30, 0.60 and 1.20 mm (2x prior dust/fine sizes).
# Fractions are mass fractions. Feed is capped at 10000 particles over 0–20 s.
fix         dust all particletemplate/sphere 15485863 atom_type 1 density constant 2650 radius constant 0.000150
fix         fine all particletemplate/sphere 15485867 atom_type 1 density constant 2650 radius constant 0.000300
fix         sand all particletemplate/sphere 32452843 atom_type 1 density constant 2650 radius constant 0.000600
fix         feedDist all particledistribution/discrete 32452867 3 dust 0.05 fine 0.25 sand 0.70

# Feed volume downstream of inlet.stl, sized for the 1.20 mm class with all_in.
# Inlet 5.0 m/s must match CFD/0/U.
# 10000 particles at 500/s finishes at t=20 s; insert_every 100000 = 0.05 s (~25/batch).
region      feed block 0.130 0.148 -0.095 -0.045 -0.025 0.025 units box
fix         inject all insert/rate/region seed 49979687 distributiontemplate feedDist nparticles 10000 particlerate 500 insert_every 100000 overlapcheck yes all_in yes vel constant -5.0 0.0 0.0 region feed

# CFD coupling (OpenFOAM / CFDEM): 20000 * 5e-7 s = 0.01 s (= 4 CFD steps)
fix         cfd all couple/cfd couple_every 20000 mpi
fix         cfd2 all couple/cfd/force/implicit

fix         integr all nve/sphere

compute     explDrag all reduce update_on_run_end yes sum f_dragforce[1] f_dragforce[2] f_dragforce[3]

variable    totalDragX equal f_cfd2[1]
variable    totalDragY equal f_cfd2[2]
variable    totalDragZ equal f_cfd2[3]
variable    explicitDragX equal c_explDrag[1]
variable    explicitDragY equal c_explDrag[2]
variable    explicitDragZ equal c_explDrag[3]
variable    time equal step*dt

fix         extra all print 2000 "${time} ${explicitDragX} ${explicitDragY} ${explicitDragZ} ${totalDragX} ${totalDragY} ${totalDragZ}" file ../DEM/post/forces.txt title "# time expDrag(X Y Z) totDrag(X Y Z)"

compute         rke all erotate/sphere
thermo_style    custom step atoms ke c_rke vol
thermo          20000
thermo_modify   lost ignore norm no

# Dump every 10000 DEM steps = 0.005 s (save interval unchanged).
dump            dmp all custom 10000 ../DEM/post/dump*.liggghts_run id type x y z vx vy vz fx fy fz f_dragforce[1] f_dragforce[2] f_dragforce[3] radius

# Binary DEM restart every write interval (needed by ./parCFDDEMcontinue.sh).
restart         10000 ../DEM/post/restart/liggghts.restart.*

run             0
